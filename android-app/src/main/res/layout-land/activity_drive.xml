<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screen" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#EDF2F6"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"><FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.36" android:layout_margin="16dp" android:background="@drawable/scene_card" android:clipToOutline="true">
<com.example.justgo.ui.RiversideSceneView android:id="@+id/scenery" android:layout_width="match_parent" android:layout_height="match_parent"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_margin="36dp" android:text="@string/app_name" android:textSize="48sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:layout_marginTop="140dp" android:padding="36dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="정하지 않아도\n좋은 길로" android:textColor="#FFFFFF" android:shadowColor="#4460849B" android:shadowRadius="5" android:shadowDy="2" android:textSize="64sp" android:layout_marginBottom="20dp"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_gravity="bottom" android:padding="36dp" android:layout_height="wrap_content" android:text="시간과 가고싶은 곳만 고르면\n가볍게 떠날 수 있어요." android:textColor="#F2F8F6" android:textSize="28sp" android:lineSpacingExtra="6dp"/></FrameLayout><ScrollView android:id="@+id/scroll" android:layout_width="0dp" android:layout_weight="0.64" android:layout_height="match_parent" android:fillViewport="true" android:layout_margin="16dp" android:background="@drawable/control_panel" android:clipToOutline="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:padding="48dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="오늘은 어떻게 달릴까요?" android:textSize="48sp" android:textColor="#123665" android:layout_marginBottom="18dp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="①  주행 방식" android:textSize="30sp" android:textStyle="bold" android:textColor="#183153" android:layout_marginBottom="18dp" />
<RadioGroup android:id="@+id/tripMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:checkedButton="@id/roundTrip" android:layout_marginBottom="24dp"><RadioButton android:id="@+id/roundTrip" style="@style/Choice"  android:text="왕복 · 출발지로 돌아오기" android:drawableStart="@drawable/ic_roundtrip" android:drawablePadding="10dp"/><RadioButton android:id="@+id/oneWay" style="@style/Choice"  android:text="편도 · 새로운 곳으로" android:drawableStart="@drawable/ic_oneway" android:drawablePadding="10dp"/></RadioGroup>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="②  드라이브 시간" android:textSize="30sp" android:textStyle="bold" android:textColor="#183153" android:layout_marginBottom="18dp" />
<RadioGroup android:id="@+id/duration" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:checkedButton="@id/time60" android:layout_marginBottom="24dp" android:background="@drawable/time_track" android:padding="6dp"><RadioButton android:id="@+id/time30" style="@style/TimeChoice"  android:text="30분"/><RadioButton android:id="@+id/time60" style="@style/TimeChoice"  android:text="60분"/><RadioButton android:id="@+id/time120" style="@style/TimeChoice"  android:text="120분"/><RadioButton android:id="@+id/timeCustom" style="@style/TimeChoice"  android:text="직접 입력"/></RadioGroup>
<LinearLayout android:id="@+id/customTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone" android:layout_marginBottom="16dp">
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="10~240분 · 5분 단위" android:textSize="26sp" android:textColor="#526A85"/>
<EditText android:id="@+id/customMinutes" android:layout_width="160dp" android:layout_height="88dp" android:textColor="#183153" android:inputType="number" android:maxLength="3" android:singleLine="true" android:text="90" android:textSize="40sp" android:textStyle="bold" android:selectAllOnFocus="true" android:hint="시간(분)" android:imeOptions="actionDone"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="분" android:textSize="36sp" android:textStyle="bold" android:textColor="#183153"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="출발지 복귀까지 · 체류 시간 제외" android:textSize="24sp" android:textColor="#526A85" android:layout_marginBottom="18dp" android:id="@+id/timeHint"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="③  가고 싶은 곳" android:textSize="30sp" android:textStyle="bold" android:textColor="#183153" android:layout_marginBottom="18dp" />
<RadioGroup android:id="@+id/theme" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:checkedButton="@id/anywhere" android:layout_marginBottom="24dp"><RadioButton android:id="@+id/anywhere" style="@style/Choice"  android:text="어디든 좋아" android:drawableTop="@drawable/ic_anywhere" android:drawablePadding="10dp"/><RadioButton android:id="@+id/city" style="@style/Choice"  android:text="도시" android:drawableTop="@drawable/ic_city" android:drawablePadding="10dp"/><RadioButton android:id="@+id/mountain" style="@style/Choice"  android:text="산" android:drawableTop="@drawable/ic_mountain" android:drawablePadding="10dp"/><RadioButton android:id="@+id/sea" style="@style/Choice"  android:text="바다" android:drawableTop="@drawable/ic_sea" android:drawablePadding="10dp"/><RadioButton android:id="@+id/water" style="@style/Choice"  android:text="강/호수" android:drawableTop="@drawable/ic_water" android:drawablePadding="10dp"/><RadioButton android:id="@+id/park" style="@style/Choice"  android:text="공원" android:drawableTop="@drawable/ic_park" android:drawablePadding="10dp"/></RadioGroup>
<Button android:id="@+id/findRoute" android:layout_width="match_parent" android:layout_height="116dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:background="@drawable/submit_background" android:backgroundTint="@null" android:text="이 조건으로 코스 찾기  →" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" android:stateListAnimator="@null" android:gravity="center_vertical|start" android:paddingStart="28dp" android:paddingEnd="28dp"/>
<LinearLayout android:id="@+id/selectionResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:layout_marginTop="20dp" android:visibility="gone" android:accessibilityLiveRegion="polite">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="선택한 조건" android:textSize="28sp" android:textColor="#1662CB" android:layout_marginBottom="18dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="32sp" android:textColor="#183153" android:layout_marginBottom="18dp" android:id="@+id/selectionSummary"/>

</LinearLayout>
</LinearLayout></ScrollView></LinearLayout></FrameLayout>
