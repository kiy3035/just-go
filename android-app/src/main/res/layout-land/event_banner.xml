<?xml version="1.0" encoding="utf-8"?>
<!-- 차량 가로 화면용 행사 추천 카드. 포스터와 두 동작을 분리해 역할을 명확히 한다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/event_banner_background"
    android:clipToOutline="true"
    android:minHeight="326dp"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/eventHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/event_banner_label"
            android:textColor="#10254A"
            android:textSize="31sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/eventRegionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="@drawable/event_banner_region"
            android:includeFontPadding="false"
            android:paddingHorizontal="13dp"
            android:paddingVertical="4dp"
            android:textColor="#174E96"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/eventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/event_banner_loading"
                android:textColor="#101C3D"
                android:textSize="30sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/eventDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#536B8D"
                android:textSize="19sp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/eventRecommendationRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/eventSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/event_recommendation_reason_background"
                    android:drawableStart="@drawable/ic_event_drive"
                    android:drawablePadding="7dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:textColor="#24558F"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:text="@string/event_banner_reason_divider"
                    android:textColor="#91A3BA"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/eventRecommendationReason"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/event_banner_recommendation"
                    android:textColor="#405A79"
                    android:textSize="18sp"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 포스터는 정보 이미지이며 다음 행사 동작을 갖지 않는다. -->
        <FrameLayout
            android:id="@+id/eventArtworkPanel"
            android:layout_width="230dp"
            android:layout_height="190dp"
            android:background="@drawable/event_thumbnail_background"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/eventArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/event_art_empty"/>
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#D6E2F1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/eventPageStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="@string/event_banner_page_preview"
            android:textColor="#6B7E98"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <Button
            android:id="@+id/eventNext"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/event_next_action"
            android:backgroundTint="@null"
            android:contentDescription="@string/event_banner_next"
            android:minWidth="0dp"
            android:paddingHorizontal="18dp"
            android:stateListAnimator="@null"
            android:text="@string/event_banner_next"
            android:textColor="#274866"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:text="@string/event_banner_reason_divider"
            android:textColor="#91A3BA"
            android:textSize="20sp"/>

        <Button
            android:id="@+id/eventNavigate"
            android:layout_width="136dp"
            android:layout_height="48dp"
            android:background="@drawable/event_banner_action"
            android:backgroundTint="@null"
            android:contentDescription="@string/event_banner_navigate_description"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:stateListAnimator="@null"
            android:text="@string/event_banner_navigate"
            android:textColor="#174EFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
