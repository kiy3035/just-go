<!-- 추천 목록과 상세 화면에서 재사용하는 코스 카드. 왼쪽에는 테마 공통 그래픽을 표시한다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/route_choice_card"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/themeGraphic"
        android:layout_width="72dp"
        android:layout_height="58dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/selection_chip"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/courseCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1659AC"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/courseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#101B34"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/courseMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#174E96"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/courseReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#365580"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
