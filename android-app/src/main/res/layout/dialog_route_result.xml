<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/control_panel"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/resultTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:textColor="#101B34"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/selectionSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#365580"
        android:textSize="21sp" />

    <RadioGroup
        android:id="@+id/routeChoices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/navigationStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="#365580"
        android:textSize="20sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/choice_background"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="취소"
            android:textColor="#183763"
            android:textSize="23sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/confirm"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="@drawable/submit_background"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="확인"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
