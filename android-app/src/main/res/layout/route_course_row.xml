<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:minHeight="64dp"
    android:background="@drawable/route_course_row_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/courseName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="#101B34"
        android:textSize="31sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/courseTheme"
        style="@style/RouteDetailChip"
        android:layout_marginStart="12dp"
        android:importantForAccessibility="no"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/courseStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:importantForAccessibility="no"
        android:textColor="#08449D"
        android:textSize="27sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/courseCheck"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/course_selection_indicator" />
</LinearLayout>
