<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#627794" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#0849A9" />
            <stroke android:width="2dp" android:color="#91C5FF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#086DF1" android:endColor="#0844B5" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
