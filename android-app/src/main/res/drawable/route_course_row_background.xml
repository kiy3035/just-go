<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="#D5E9FF" />
            <stroke android:width="2dp" android:color="#137CF0" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#E9F4FF" />
            <stroke android:width="2dp" android:color="#4699EF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#F9FCFF" />
            <stroke android:width="1dp" android:color="#C3D6EE" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
