<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FFFFFF"/>
            <corners android:radius="14dp"/>
            <stroke android:width="3dp" android:color="#2875F5"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#E8F1FD"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#AFC8E8"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FFFFFF"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#D6E2F1"/>
        </shape>
    </item>
</selector>
