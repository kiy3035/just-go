<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#DCEBFF" />
            <stroke android:width="2dp" android:color="#247BEB" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#F5F9FF" />
            <stroke android:width="1dp" android:color="#D3E2F4" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
