# backend/.env로 복사한 뒤 로컬 값만 입력합니다. 실제 값은 Git에 커밋하지 않습니다.
DB_URL=jdbc:postgresql://127.0.0.1:5432/justgo
DB_USERNAME=justgo
DB_PASSWORD=replace-with-local-database-password
SERVER_ADDRESS=127.0.0.1
TMAP_APP_KEY=replace-with-local-tmap-app-key
TMAP_DAILY_CALL_LIMIT=90
PARK_API_KEY=replace-with-public-data-service-key
PARK_API_URL=https://api.data.go.kr/openapi/tn_pubr_public_cty_park_info_api
TOUR_API_KEY=replace-with-public-data-service-key
TOUR_API_URL=https://apis.data.go.kr/B551011/KorService2/locationBasedList2
PARK_CACHE_TTL=6h
ROUTE_API_ACCESS_TOKEN_REQUIRED=false
ROUTE_API_ACCESS_TOKEN=replace-with-random-client-access-token
ROUTE_API_REQUESTS_PER_MINUTE=4
ROUTE_API_MAX_CONCURRENT_REQUESTS=2
ROUTE_API_MAX_REQUEST_BODY_BYTES=8192
ROUTE_API_MAX_TRACKED_CLIENTS=2048
SCENIC_CANDIDATE_IMPORT_DRY_RUN=false
